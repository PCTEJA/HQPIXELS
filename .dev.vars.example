# Local Worker secrets for `vite dev` / `wrangler dev`.
# Copy to `.dev.vars` (gitignored) and fill in SANDBOX values only.
# `.dev.vars` uses the same KEY=value syntax as a dotenv file but is read by
# Wrangler/the Cloudflare Vite plugin and injected into the Worker `env`.

ENVIRONMENT=development
PUBLIC_SITE_URL=http://localhost:5173

SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=REPLACE_WITH_LOCAL_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_LOCAL_SERVICE_ROLE_KEY

STRIPE_SECRET_KEY=rk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

CF_IMAGES_ACCOUNT_ID=REPLACE_ME
CF_IMAGES_API_TOKEN=REPLACE_ME
CF_IMAGES_DELIVERY_BASE=https://imagedelivery.net/REPLACE_ACCOUNT_HASH
CF_IMAGES_PUBLIC_VARIANT=wall
CF_IMAGES_THUMB_VARIANT=thumb

APP_SIGNING_SECRET=REPLACE_WITH_48_RANDOM_BYTES
ADMIN_EMAIL_ALLOWLIST=you@example.com

SENTRY_DSN=
REQUIRE_MANUAL_APPROVAL=true
ADMIN_SURFACE_DISABLED=false
