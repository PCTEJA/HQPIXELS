{
  "name": "hqpixels",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "HQPixels — an interactive pixel-ad marketplace on a 1000x1000 logical-pixel wall.",
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": ">=22.11.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "pnpm run headers && vite",
    "build": "pnpm run typecheck && pnpm run headers && vite build && pnpm run verify:csp",
    "build:staging": "cross-env CLOUDFLARE_ENV=staging pnpm run build",
    "build:production": "cross-env CLOUDFLARE_ENV=production pnpm run build",
    "headers": "node scripts/generate-headers.mjs",
    "headers:check": "node scripts/generate-headers.mjs --check",
    "verify:csp": "node scripts/assert-no-inline-scripts.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.worker.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:a11y": "playwright test --grep @a11y",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:migrate:local": "supabase db reset --no-seed",
    "db:migrate:remote": "supabase db push --linked",
    "db:diff": "supabase db diff -f",
    "db:test": "supabase test db",
    "db:seed:dev": "psql \"$SUPABASE_DB_URL\" -v ON_ERROR_STOP=1 -f supabase/seed.dev.sql",
    "cf:types": "wrangler types worker/worker-env.d.ts",
    "deploy:staging": "pnpm run build:staging && wrangler deploy",
    "deploy:production": "pnpm run build:production && wrangler deploy",
    "rollback:production": "wrangler rollback --env production",
    "secrets:staging": "bash scripts/put-secrets.sh staging",
    "secrets:production": "bash scripts/put-secrets.sh production",
    "stripe:listen": "stripe listen --forward-to http://localhost:5173/api/stripe/webhook",
    "load:claims": "k6 run tests/load/01-concurrent-claims.js",
    "load:viewers": "k6 run tests/load/02-cached-viewers.js",
    "verify": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test",
    "prepare": "node scripts/check-node.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.49.4",
    "@tanstack/react-query": "^5.66.0",
    "hono": "^4.7.4",
    "pixi.js": "^8.8.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.2.0",
    "stripe": "^22.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/vite-plugin": "^1.0.12",
    "@cloudflare/workers-types": "^5.20260828.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.51.1",
    "@tailwindcss/vite": "^4.0.14",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "axe-playwright": "^2.1.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.22.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^17.11.0",
    "prettier": "^3.5.3",
    "tailwindcss": "^4.0.14",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.27.0",
    "vite": "^8.2.2",
    "vitest": "^3.0.9",
    "wrangler": "^4.4.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  }
}
