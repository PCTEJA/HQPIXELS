# Deterministic, audit-friendly installs.
engine-strict=true
save-exact=false
prefer-frozen-lockfile=true
# Reduce supply-chain blast radius: no arbitrary postinstall scripts unless allowlisted
# in package.json -> pnpm.onlyBuiltDependencies.
enable-pre-post-scripts=false
# Fail the install if the registry response is tampered with.
strict-peer-dependencies=false
resolution-mode=highest
