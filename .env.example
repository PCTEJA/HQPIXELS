# =============================================================================
# HQPixels — environment variable reference
# =============================================================================
# THIS FILE CONTAINS PLACEHOLDERS ONLY. Never put a real secret in this file,
# in git, in a screenshot, in a support ticket, or in a chat message.
#
# Two different mechanisms hold configuration:
#
#   1. Client-visible values  -> `VITE_*` in a local `.env` file. These are
#      compiled into the browser bundle. Treat every VITE_* value as PUBLIC.
#
#   2. Worker (server) values -> `.dev.vars` locally, and
#      `wrangler secret put NAME --env production` in staging/production.
#      These are never sent to the browser.
#
# Copy this file to `.env` (client) and `.dev.vars` (worker) and fill in your
# own sandbox values. See README.md -> "Environment variables" for the full
# classification table.
# =============================================================================


# -----------------------------------------------------------------------------
# CLIENT (PUBLIC — compiled into the browser bundle)
# -----------------------------------------------------------------------------

# Canonical site origin. Used for canonical URLs, Open Graph tags and
# same-origin checks in the client. No trailing slash.
VITE_SITE_URL=http://localhost:5173

# Cloudflare Turnstile *site* key (public by design).
# Development/testing keys are published by Cloudflare:
#   1x00000000000000000000AA  = always passes (visible)
#   2x00000000000000000000AB  = always blocks
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Optional: Sentry browser DSN. A DSN is public but rate-limited; leave empty to
# disable client error reporting.
VITE_SENTRY_DSN=

# "development" | "staging" | "production" — only affects labels and sampling.
VITE_ENVIRONMENT=development


# -----------------------------------------------------------------------------
# WORKER (SECRET — put these in .dev.vars locally / wrangler secrets in cloud)
# -----------------------------------------------------------------------------

# --- Supabase -----------------------------------------------------------------
# Project URL, e.g. https://abcdefghijklmnop.supabase.co (local: http://127.0.0.1:54321)
SUPABASE_URL=http://127.0.0.1:54321

# Publishable / anon key. Safe to expose, but we keep it server-side because the
# browser never talks to Supabase directly in this architecture.
SUPABASE_ANON_KEY=REPLACE_WITH_LOCAL_ANON_KEY

# SECRET. Service-role (or new "secret") key. Bypasses RLS. Worker only.
# If this leaks, rotate it immediately (see RUNBOOK.md -> Key rotation).
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_LOCAL_SERVICE_ROLE_KEY

# --- Stripe -------------------------------------------------------------------
# SECRET. Prefer a *restricted* key. Required permissions:
#   Checkout Sessions: write | PaymentIntents: read | Charges: read
#   Refunds: write     | Disputes: read      | Events: read
STRIPE_SECRET_KEY=rk_test_REPLACE_ME

# SECRET. From the Stripe Dashboard webhook endpoint, or printed by
# `stripe listen` as `whsec_...` during local development.
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# --- Cloudflare Turnstile -----------------------------------------------------
# SECRET. Matching secret key for VITE_TURNSTILE_SITE_KEY.
# Cloudflare's always-passes test secret: 1x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# --- Cloudflare Images (media pipeline) ---------------------------------------
# Account ID that owns the Images product.
CF_IMAGES_ACCOUNT_ID=REPLACE_ME
# SECRET. API token scoped to *only* "Cloudflare Images: Edit" for this account.
CF_IMAGES_API_TOKEN=REPLACE_ME
# Public delivery hostname, e.g. imagedelivery.net/<account-hash>
CF_IMAGES_DELIVERY_BASE=https://imagedelivery.net/REPLACE_ACCOUNT_HASH
# Variant names configured in the Images dashboard (see DEPLOYMENT.md).
CF_IMAGES_PUBLIC_VARIANT=wall
CF_IMAGES_THUMB_VARIANT=thumb

# --- Application secrets ------------------------------------------------------
# SECRET. 32+ random bytes, base64url. Signs CSRF tokens and opaque state values.
# Generate: openssl rand -base64 48 | tr '+/' '-_' | tr -d '='
APP_SIGNING_SECRET=REPLACE_WITH_48_RANDOM_BYTES

# Comma-separated list of email addresses allowed to bootstrap admin access.
# This is an *allowlist*, not authorization: the account must ALSO have
# profiles.is_admin = true. See README.md -> "Creating the first admin".
ADMIN_EMAIL_ALLOWLIST=you@example.com

# --- Observability ------------------------------------------------------------
# Optional. SECRET (server DSNs are effectively write keys).
SENTRY_DSN=
# "development" | "staging" | "production"
ENVIRONMENT=development
# Canonical origin used for Origin/Referer validation and redirect building.
PUBLIC_SITE_URL=http://localhost:5173

# --- Feature flags ------------------------------------------------------------
# When "true", newly paid placements still require admin approval (recommended).
REQUIRE_MANUAL_APPROVAL=true
# When "true", the /admin surface is disabled entirely (break-glass switch).
ADMIN_SURFACE_DISABLED=false
