{
  "//": "Build tooling + tests. Node globals, no DOM lib assumptions beyond what Vitest provides.",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM"],
    "types": ["node", "vitest/globals"],
    "jsx": "react-jsx",
    "noUnusedLocals": false
  },
  "include": [
    "vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "eslint.config.js",
    "scripts/**/*.ts",
    "scripts/**/*.mjs",
    "tests/**/*.ts",
    "shared/**/*.ts",
    "worker/**/*.ts"
  ]
}
